# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Use a THROWAWAY key -- it is stored in plaintext and used to sign broadcasts.
#
#   cast wallet new                                    # generate
#   cast wallet address --private-key $PRIVATE_KEY     # address to fund
#   https://faucet.monad.xyz                           # ~4 MON (deploy costs 3.58)

PRIVATE_KEY=

